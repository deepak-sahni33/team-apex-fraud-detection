# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# Provide local MongoDB or MongoDB Atlas URI (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/ScamShield )
MONGODB_URI=mongodb://127.0.0.1:27017/ScamShield 

# AI Provider Configuration (Optional)
# If left empty, ScamShield  AI automatically uses its high-accuracy deterministic rule-based threat engine.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Alternative: OpenAI (uncomment to use)
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
